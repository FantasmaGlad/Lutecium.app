{
	email {$CADDY_ACME_EMAIL}
}

{$LUTECIUM_DOMAIN} {
	handle /api/* {
		reverse_proxy lutecium-api:8000
	}
	handle {
		root * /srv/site
		# Repli SPA : toute route qui ne correspond pas à un fichier statique réel
		# (ex. /login, /historique, /admin) doit servir index.html pour que React
		# Router prenne le relais côté client — sans ça, navigation directe/rechargement
		# sur une route autre que / renvoie 404.
		try_files {path} /index.html
		file_server
	}
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
		# Frontend statique auto-hébergé (pas de script/style inline, pas de CDN) + miniatures
		# externes (yt-dlp renvoie des URLs de miniatures issues du site source, F-11).
		Content-Security-Policy "default-src 'self'; img-src 'self' https:; connect-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
}
