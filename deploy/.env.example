# Variables du provisioning Phase 0 (Caddy + DuckDNS).
# Copier en deploy/.env sur le serveur (jamais commité) et compléter.

# Domaine(s) servi(s) par Caddy (S-03). Plusieurs domaines : séparés par ", " (site address list Caddy).
LUTECIUM_DOMAIN=lutecium.app, lutecium.duckdns.org

# Sous-domaine DuckDNS (sans le .duckdns.org)
DUCKDNS_SUBDOMAIN=lutecium

# Token DuckDNS — récupéré sur https://www.duckdns.org une fois connecté
DUCKDNS_TOKEN=

# Email utilisé pour l'enregistrement Let's Encrypt (S-03)
CADDY_ACME_EMAIL=admin@example.com

# UID/GID de l'utilisateur système exécutant les conteneurs (S-09)
PUID=1000
PGID=1000
