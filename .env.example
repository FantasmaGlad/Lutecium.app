# Configuration Lutecium — copier en .env (jamais commité) et adapter.
# Défauts alignés sur le cahier des charges §6.

# Base de données (migration future PostgreSQL : changer uniquement DATABASE_URL)
DATABASE_URL=sqlite+aiosqlite:///./data/lutecium.db

# Clé de signature des sessions et des liens de téléchargement (S-04, F-24) — à régénérer en prod
SECRET_KEY=change-me-in-production

# Quotas et limites (§6)
USER_DAILY_QUOTA_GB=20
GUEST_DOWNLOAD_LIMIT=1
MAX_FILE_SIZE_GB=8
GLOBAL_DOWNLOADS_CAP_GB=15
MAX_CONCURRENT_DOWNLOADS=2
MAX_QUEUE_SIZE=20
FILE_TTL_MINUTES=5
SESSION_DAYS=30
ANALYZE_RATE_LIMIT_PER_MINUTE=10

# Stockage des fichiers temporaires (ignoré par git)
DOWNLOADS_DIR=./data/downloads

# Bootstrap du compte admin (A-01) : si renseignés et qu'aucun admin n'existe encore,
# un compte admin est créé au démarrage. Laisser vide sinon (jamais d'identifiants par défaut).
# ADMIN_PSEUDO=
# ADMIN_PASSWORD=
